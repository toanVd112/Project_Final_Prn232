@model Project_Final_FE.Models.BookSearchViewModel
@{
    ViewData["Title"] = "Trang chủ - Tra cứu sách";
}

<!-- Hero Banner -->
<div class="p-5 mb-4 bg-white rounded-4 shadow-sm border border-light text-center">
    <div class="container-fluid py-2">
        <h1 class="display-5 fw-bold text-primary mb-3">
            <i class="bi bi-book-half me-2"></i>Thư viện Tri thức Trực tuyến
        </h1>
        <p class="col-md-8 fs-5 text-muted mx-auto mb-4">
            Khám phá hàng ngàn đầu sách công nghệ, kinh tế, khoa học và văn học. Mượn sách trực tuyến nhanh chóng và thuận tiện.
        </p>

        <!-- Search & Filter Bar -->
        <form method="get" asp-action="Index" class="row g-2 justify-content-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên sách hoặc tác giả..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả thể loại --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">
                            @cat.Name (@cat.BookCount)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-funnel me-1"></i> Tìm kiếm
                </button>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search) || Model.CategoryId.HasValue)
            {
                <div class="col-md-1">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100" title="Đặt lại bộ lọc">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Categories Pills -->
<div class="d-flex flex-wrap gap-2 justify-content-center mb-4">
    <a asp-action="Index" class="btn btn-sm @(!Model.CategoryId.HasValue ? "btn-primary" : "btn-light border") rounded-pill px-3">
        Tất cả
    </a>
    @foreach (var cat in Model.Categories)
    {
        <a asp-action="Index" asp-route-categoryId="@cat.CategoryId" asp-route-search="@Model.Search"
           class="btn btn-sm @(Model.CategoryId == cat.CategoryId ? "btn-primary" : "btn-light border") rounded-pill px-3">
            @cat.Name <span class="badge bg-secondary ms-1">@cat.BookCount</span>
        </a>
    }
</div>

<!-- Books Grid -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-4">
    @if (Model.Books.Items.Any())
    {
        @foreach (var book in Model.Books.Items)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge bg-light text-primary border">
                                <i class="bi bi-tag-fill me-1"></i>@book.CategoryName
                            </span>
                        </div>
                        <h5 class="card-title fw-bold text-dark mb-1 text-truncate" title="@book.Title">
                            <a asp-action="Details" asp-route-id="@book.BookId" class="text-decoration-none text-dark hover-primary">
                                @book.Title
                            </a>
                        </h5>
                        <p class="card-subtitle text-muted small mb-3 text-truncate">
                            <i class="bi bi-person me-1"></i>@book.Author
                        </p>

                        <div class="mt-auto pt-2 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Giá bìa:</span>
                                <span class="fw-bold text-success">@book.Price.ToString("N0") đ</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted small">Khả dụng:</span>
                                @if (book.AvailableCopies > 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Còn @book.AvailableCopies/@book.TotalCopies cuốn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="bi bi-x-circle me-1"></i>Tạm hết
                                    </span>
                                }
                            </div>

                            <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-primary w-100 btn-sm fw-medium">
                                <i class="bi bi-info-circle me-1"></i> Chi tiết & Mượn sách
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="text-muted mb-3">
                <i class="bi bi-journal-x fs-1 text-secondary"></i>
            </div>
            <h5 class="fw-bold text-dark">Không tìm thấy sách nào phù hợp</h5>
            <p class="text-muted">Hãy thử thay đổi từ khóa tìm kiếm hoặc chọn danh mục thể loại khác.</p>
            <a asp-action="Index" class="btn btn-primary btn-sm">Xem tất cả sách</a>
        </div>
    }
</div>

<!-- Pagination -->
@if (Model.Books.TotalPages > 1)
{
    <nav aria-label="Phân trang sách">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.Books.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.Books.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId">
                    <i class="bi bi-chevron-left"></i> Trước
                </a>
            </li>

            @for (int i = 1; i <= Model.Books.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Books.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId">@i</a>
                </li>
            }

            <li class="page-item @(!Model.Books.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.Books.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId">
                    Sau <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
