@model Project_Final_FE.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center py-4">
    <div class="col-md-5 col-lg-4">
        <div class="card p-4 shadow-sm border-0">
            <div class="text-center mb-4">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 54px; height: 54px;">
                    <i class="bi bi-person-fill-lock fs-3"></i>
                </div>
                <h3 class="fw-bold mb-1">Đăng nhập</h3>
                <p class="text-muted small">Truy cập hệ thống Quản lý Thư viện</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-medium">Địa chỉ Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="name@library.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-medium">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                </button>

                <div class="text-center small text-muted">
                    Chưa có tài khoản độc giả? <a asp-action="Register" class="text-primary text-decoration-none fw-semibold">Đăng ký tại đây</a>
                </div>
            </form>

            <div class="mt-4 pt-3 border-top text-muted small">
                <p class="mb-1 fw-bold text-dark">Tài khoản demo:</p>
                <div><span class="badge bg-danger">Admin</span> <code>admin@library.com</code> / <code>Admin@123</code></div>
                <div class="mt-1"><span class="badge bg-primary">Member</span> <code>member1@library.com</code> / <code>Member@123</code></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
