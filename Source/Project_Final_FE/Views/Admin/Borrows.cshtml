@model Project_Final_FE.Models.BorrowAdminFilterViewModel
@{
    ViewData["Title"] = "Quản lý Mượn / Trả tại quầy";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-arrow-left-right text-warning me-2"></i>Quản lý Mượn / Trả & Thu phạt tại quầy
            </h2>
            <p class="text-muted mb-0">Xác nhận nhận lại sách vật lý, ghi nhận báo mất sách và giải trừ công nợ tại quầy thư viện.</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white">
        <form method="get" asp-action="Borrows" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-medium mb-1">Trạng thái mượn</label>
                <select name="status" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Borrowed" selected="@(Model.Status == "Borrowed")">Đang mượn</option>
                    <option value="Returned" selected="@(Model.Status == "Returned")">Đã trả sách</option>
                    <option value="Lost" selected="@(Model.Status == "Lost")">Báo mất sách</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-medium mb-1">Tình trạng nộp tiền phạt</label>
                <select name="isFinePaid" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="false" selected="@(Model.IsFinePaid == false)">Chưa nộp tiền phạt / đền bù</option>
                    <option value="true" selected="@(Model.IsFinePaid == true)">Đã nộp đủ tiền</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-medium">
                    <i class="bi bi-filter me-1"></i> Lọc danh sách
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Borrows" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                </a>
            </div>
        </form>
    </div>

    <!-- Borrows Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã #</th>
                            <th>Độc giả</th>
                            <th>Đầu sách</th>
                            <th>Ngày mượn</th>
                            <th>Hạn trả</th>
                            <th>Trạng thái</th>
                            <th>Phạt / Đền bù</th>
                            <th class="text-end pe-4">Thao tác tại quầy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Borrows.Items.Any())
                        {
                            @foreach (var item in Model.Borrows.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@item.BorrowRecordId</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.UserFullName</div>
                                        <div class="text-muted small">@item.UserEmail</div>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark">@item.BookTitle</div>
                                        <div class="text-muted small">@item.BookAuthor</div>
                                    </td>
                                    <td>@item.BorrowDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="fw-medium">@item.DueDate.ToString("dd/MM/yyyy")</span>
                                        @if (item.IsOverdue)
                                        {
                                            <div class="badge bg-danger small mt-1">Trễ @item.DaysOverdue ngày</div>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == "Borrowed")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-hourglass-split me-1"></i>Đang mượn
                                            </span>
                                        }
                                        else if (item.Status == "Returned")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>Đã trả
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-x-octagon me-1"></i>Mất sách
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var totalFee = item.Fine + (item.CompensationFee ?? 0);
                                            if (item.Status == "Borrowed" && item.EstimatedFine > 0)
                                            {
                                                totalFee = item.EstimatedFine;
                                            }
                                        }
                                        @if (totalFee > 0)
                                        {
                                            <div class="text-danger fw-bold">@totalFee.ToString("N0") VNĐ</div>
                                            @if (item.IsFinePaid)
                                            {
                                                <span class="badge bg-success" style="font-size: 0.75rem;">Đã thu tiền</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger" style="font-size: 0.75rem;">Chưa thu</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">0 VNĐ</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            @if (item.Status == "Borrowed")
                                            {
                                                <!-- Nút Xác nhận Trả sách -->
                                                <form asp-action="ReturnBook" asp-route-id="@item.BorrowRecordId" method="post" class="d-inline" onsubmit="return confirm('Xác nhận nhận lại sách tại quầy cho độc giả @item.UserFullName?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success fw-medium">
                                                        <i class="bi bi-check2-square me-1"></i> Trả sách
                                                    </button>
                                                </form>

                                                <!-- Nút Báo mất sách -->
                                                <form asp-action="ReportLost" asp-route-id="@item.BorrowRecordId" method="post" class="d-inline ms-1" onsubmit="return confirm('Xác nhận báo mất sách? Hệ thống sẽ ghi nhận phí bồi thường bằng giá bìa.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-medium">
                                                        <i class="bi bi-exclamation-octagon me-1"></i> Báo mất
                                                    </button>
                                                </form>
                                            }
                                            else if (!item.IsFinePaid && (item.Fine > 0 || (item.CompensationFee ?? 0) > 0))
                                            {
                                                <!-- Nút Thu tiền phạt -->
                                                <form asp-action="PayFine" asp-route-id="@item.BorrowRecordId" method="post" class="d-inline" onsubmit="return confirm('Xác nhận đã thu đủ @((item.Fine + (item.CompensationFee ?? 0)).ToString("N0")) VNĐ từ độc giả?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-primary fw-medium">
                                                        <i class="bi bi-cash-coin me-1"></i> Thu tiền
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border py-2 px-3">Hoàn tất</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Không có bản ghi mượn nào phù hợp với bộ lọc.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Borrows.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Phân trang mượn trả">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.Borrows.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Borrows"
                       asp-route-pageNumber="@(Model.Borrows.PageNumber - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-status="@Model.Status"
                       asp-route-isFinePaid="@Model.IsFinePaid">Trước</a>
                </li>
                @for (int i = 1; i <= Model.Borrows.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Borrows.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Borrows"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-status="@Model.Status"
                           asp-route-isFinePaid="@Model.IsFinePaid">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.Borrows.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Borrows"
                       asp-route-pageNumber="@(Model.Borrows.PageNumber + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-status="@Model.Status"
                       asp-route-isFinePaid="@Model.IsFinePaid">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
