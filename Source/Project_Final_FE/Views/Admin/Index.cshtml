@{
    ViewData["Title"] = "Dashboard Quản trị";
    var recentBorrows = ViewBag.RecentBorrows as List<Project_Final_FE.Models.BorrowRecordViewModel> ?? new List<Project_Final_FE.Models.BorrowRecordViewModel>();
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Bảng điều khiển Quản trị Thư viện
            </h2>
            <p class="text-muted mb-0">Theo dõi số liệu vận hành kho sách, mượn/trả và tình trạng công nợ.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Borrows" class="btn btn-warning fw-semibold">
                <i class="bi bi-arrow-left-right me-1"></i> Quầy Mượn/Trả
            </a>
            <a asp-action="CreateBook" class="btn btn-primary fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Nhập thêm sách
            </a>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3 me-3">
                        <i class="bi bi-book fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Tổng đầu sách</span>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalBooks</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-info-subtle text-info p-3 me-3">
                        <i class="bi bi-tags fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Thể loại sách</span>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalCategories</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-success-subtle text-success p-3 me-3">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Đang cho mượn</span>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.ActiveBorrows</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 bg-danger-subtle text-danger p-3 me-3">
                        <i class="bi bi-exclamation-octagon fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Sách quá hạn / Nợ phạt</span>
                        <h3 class="fw-bold mb-0 text-danger">@ViewBag.OverdueBorrows</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Borrows -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-clock-history me-2 text-primary"></i>Các giao dịch mượn gần đây nhất
            </h5>
            <a asp-action="Borrows" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
        </div>
        <div class="card-body p-0">
            @if (recentBorrows.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Độc giả</th>
                                <th>Sách</th>
                                <th>Ngày mượn</th>
                                <th>Hạn trả</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-4">Thao tác tại quầy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in recentBorrows)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.UserFullName</div>
                                        <div class="text-muted small">@item.UserEmail</div>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark">@item.BookTitle</div>
                                    </td>
                                    <td>@item.BorrowDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span>@item.DueDate.ToString("dd/MM/yyyy")</span>
                                        @if (item.IsOverdue)
                                        {
                                            <span class="badge bg-danger ms-1">Trễ @item.DaysOverdue ngày</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == "Borrowed")
                                        {
                                            <span class="badge bg-primary">Đang mượn</span>
                                        }
                                        else if (item.Status == "Returned")
                                        {
                                            <span class="badge bg-success">Đã trả</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Mất sách</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Borrows" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">Chưa có giao dịch mượn nào.</div>
            }
        </div>
    </div>
</div>
