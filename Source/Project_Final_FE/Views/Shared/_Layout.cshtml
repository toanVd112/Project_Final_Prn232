@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    var userFullName = HttpContextAccessor.HttpContext?.Session.GetString("UserFullName");
    var isLoggedIn = !string.IsNullOrEmpty(userRole);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management System</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand {
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #2563eb !important;
        }
        .main-content {
            flex: 1 0 auto;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            transition: all 0.2s ease-in-out;
        }
        .card:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
        }
        .btn-primary {
            background-color: #2563eb;
            border-color: #2563eb;
            border-radius: 8px;
            font-weight: 500;
        }
        .btn-primary:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
        }
        .badge-status {
            font-size: 0.85rem;
            padding: 6px 12px;
            border-radius: 20px;
        }
        .footer {
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            padding: 24px 0;
            margin-top: 48px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half text-primary fs-3"></i>
                    <span>LibraryHub</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Trang chủ / Tra cứu sách
                            </a>
                        </li>
                        @if (isLoggedIn && userRole == "Member")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium" asp-controller="Borrows" asp-action="MyBorrows">
                                    <i class="bi bi-journal-bookmark me-1 text-primary"></i> Sách đang mượn & Lịch sử
                                </a>
                            </li>
                        }
                        @if (isLoggedIn && userRole == "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-semibold" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1 text-danger"></i> Quản trị Thư viện
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="adminMenu">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard Tổng quan
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Borrows">
                                            <i class="bi bi-arrow-left-right me-2 text-warning"></i> Quản lý Mượn / Trả tại quầy
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Books">
                                            <i class="bi bi-book me-2 text-success"></i> Quản lý Kho sách
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Categories">
                                            <i class="bi bi-tags me-2 text-info"></i> Quản lý Thể loại sách
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        @if (isLoggedIn)
                        {
                            <!-- Notification Bell Dropdown -->
                            <li class="nav-item dropdown" id="notificationDropdownContainer">
                                <a class="nav-link text-dark position-relative p-2 rounded-circle hover-bg-light" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo">
                                    <i class="bi bi-bell fs-5"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notificationBadge" style="font-size: 0.65rem;">
                                        0
                                    </span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0" aria-labelledby="notificationDropdown" style="width: 360px; max-width: 90vw; border-radius: 12px; overflow: hidden;">
                                    <div class="p-3 bg-primary text-white d-flex justify-content-between align-items-center">
                                        <div class="fw-bold fs-6"><i class="bi bi-bell-fill me-2"></i>Thông báo</div>
                                        <button type="button" class="btn btn-sm btn-outline-light py-0 px-2 small" onclick="markAllNotificationsAsRead(event)">
                                            Đã đọc tất cả
                                        </button>
                                    </div>
                                    <div class="list-group list-group-flush" id="notificationList" style="max-height: 380px; overflow-y: auto;">
                                        <div class="p-4 text-center text-muted small" id="notificationEmpty">
                                            <i class="bi bi-bell-slash fs-3 d-block mb-1 text-secondary"></i>
                                            Chưa có thông báo nào.
                                        </div>
                                    </div>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-dark" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px;">
                                        @(userFullName?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-truncate" style="max-width: 150px;">@userFullName</div>
                                        <span class="badge @(userRole == "Admin" ? "bg-danger" : "bg-primary")" style="font-size: 0.7rem;">@userRole</span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenu">
                                    @if (userRole == "Member")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Borrows" asp-action="MyBorrows">
                                                <i class="bi bi-journal-text me-2"></i> Lịch sử mượn sách
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary px-3" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary px-3" asp-controller="Auth" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-content container py-4">
        <!-- Thông báo Flash Messages -->
        @await Html.PartialAsync("_Notification")
        @RenderBody()
    </main>

    <footer class="footer text-muted">
        <div class="container text-center">
            <p class="mb-1 fw-semibold text-dark">Library Management System &copy; 2026</p>
            <p class="mb-0 small text-secondary">Đồ án ASP.NET Core Web API & MVC Client (.NET 8) — PRN232</p>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 for rich alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (isLoggedIn)
    {
        <script>
            async function loadNotifications() {
                try {
                    const res = await fetch('/Notifications/GetSummary');
                    if (!res.ok) return;
                    const data = await res.json();

                    const badge = document.getElementById('notificationBadge');
                    const list = document.getElementById('notificationList');

                    if (data.unreadCount > 0) {
                        badge.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
                        badge.classList.remove('d-none');
                    } else {
                        badge.classList.add('d-none');
                    }

                    if (data.notifications && data.notifications.length > 0) {
                        list.innerHTML = data.notifications.map(n => {
                            let icon = '<i class="bi bi-info-circle-fill text-primary fs-5"></i>';
                            let bgClass = n.isRead ? '' : 'bg-light';

                            if (n.type === 'BorrowSuccess') {
                                icon = '<i class="bi bi-check-circle-fill text-success fs-5"></i>';
                            } else if (n.type === 'AdminNewBorrow') {
                                icon = '<i class="bi bi-book-half text-primary fs-5"></i>';
                            } else if (n.type === 'DueDateReminder') {
                                icon = '<i class="bi bi-alarm-fill text-warning fs-5"></i>';
                            }

                            return `
                                <div class="list-group-item list-group-item-action p-3 border-bottom ${bgClass}" onclick="markNotificationAsRead(${n.notificationId}, event)" style="cursor: pointer;">
                                    <div class="d-flex align-items-start gap-2">
                                        <div class="mt-1">${icon}</div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold small text-dark ${n.isRead ? 'text-muted' : ''}">${n.title}</span>
                                                <span class="text-muted" style="font-size: 0.7rem;">${n.timeAgo}</span>
                                            </div>
                                            <p class="mb-0 text-secondary small line-clamp-2" style="font-size: 0.8rem; line-height: 1.3;">${n.message}</p>
                                        </div>
                                        ${!n.isRead ? '<span class="p-1 bg-primary rounded-circle align-self-center ms-1" style="width: 8px; height: 8px;"></span>' : ''}
                                    </div>
                                </div>
                            `;
                        }).join('');
                    } else {
                        list.innerHTML = `
                            <div class="p-4 text-center text-muted small">
                                <i class="bi bi-bell-slash fs-3 d-block mb-1 text-secondary"></i>
                                Chưa có thông báo nào.
                            </div>
                        `;
                    }
                } catch (e) {
                    console.error('Error fetching notifications:', e);
                }
            }

            async function markNotificationAsRead(id, event) {
                try {
                    await fetch(`/Notifications/MarkAsRead/${id}`, { method: 'POST' });
                    loadNotifications();
                } catch (e) {
                    console.error('Error marking notification as read:', e);
                }
            }

            async function markAllNotificationsAsRead(event) {
                event.stopPropagation();
                try {
                    await fetch('/Notifications/MarkAllAsRead', { method: 'POST' });
                    loadNotifications();
                } catch (e) {
                    console.error('Error marking all as read:', e);
                }
            }

            document.addEventListener('DOMContentLoaded', () => {
                loadNotifications();
                // Tự động kiểm tra thông báo mới mỗi 30 giây
                setInterval(loadNotifications, 30000);
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
